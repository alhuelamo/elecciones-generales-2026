{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ballot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chamber",
    "constituencyId",
    "seats",
    "maxMarks",
    "sources",
    "candidacies",
    "constituencyResults2023"
  ],
  "properties": {
    "chamber": { "enum": ["congreso", "senado"] },
    "constituencyId": { "type": "string", "pattern": "^\\d{2}(-[a-z-]+)?$" },
    "seats": { "type": "integer", "minimum": 1 },
    "maxMarks": { "type": ["integer", "null"], "minimum": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" }
        }
      }
    },
    "candidacies": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidacy" }
    },
    "constituencyResults2023": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/constituencyResults2023" }]
    }
  },
  "$defs": {
    "partyResult2023": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acronym", "name", "votes", "percentage", "seats", "color"],
      "properties": {
        "acronym": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "votes": { "type": ["integer", "null"], "minimum": 0 },
        "percentage": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "seats": { "type": "integer", "minimum": 0 },
        "color": { "type": ["string", "null"], "pattern": "^#[0-9a-f]{6}$" }
      }
    },
    "constituencyResults2023": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electorate",
        "totalVotes",
        "turnoutPercentage",
        "validVotes",
        "blankVotes",
        "blankPercentage",
        "combinedDistrictName",
        "parties"
      ],
      "properties": {
        "electorate": { "type": "integer", "minimum": 0 },
        "totalVotes": { "type": "integer", "minimum": 0 },
        "turnoutPercentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "validVotes": { "type": "integer", "minimum": 0 },
        "blankVotes": { "type": "integer", "minimum": 0 },
        "blankPercentage": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "combinedDistrictName": { "type": ["string", "null"], "minLength": 1 },
        "parties": { "type": "array", "items": { "$ref": "#/$defs/partyResult2023" } }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "name", "substituteNames"],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "substituteNames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "results2023": {
      "type": "object",
      "additionalProperties": false,
      "required": ["votes", "percentage", "seats", "asAcronyms"],
      "properties": {
        "votes": { "type": "integer", "minimum": 0 },
        "percentage": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "seats": { "type": "integer", "minimum": 0 },
        "asAcronyms": { "type": "array", "items": { "type": "string" } }
      }
    },
    "candidacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "boeOrder",
        "denomination",
        "acronym",
        "partyKey",
        "isCoalition",
        "candidates",
        "substitutes",
        "results2023"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "boeOrder": { "type": "integer", "minimum": 1 },
        "denomination": { "type": "string", "minLength": 1 },
        "acronym": { "type": "string" },
        "partyKey": { "type": ["string", "null"] },
        "isCoalition": { "type": "boolean" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidate" }
        },
        "substitutes": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidate" }
        },
        "results2023": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/results2023" }]
        }
      }
    }
  }
}
