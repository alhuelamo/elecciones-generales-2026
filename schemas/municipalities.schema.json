{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "municipalities.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "generatedAt", "constituencies", "municipalities"],
  "properties": {
    "dataset": { "enum": ["fixture", "boe-2026"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "constituencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["congreso", "senado"],
      "properties": {
        "congreso": {
          "type": "array",
          "items": { "$ref": "#/$defs/constituency" }
        },
        "senado": {
          "type": "array",
          "items": { "$ref": "#/$defs/constituency" }
        }
      }
    },
    "municipalities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "aliases", "congreso", "senado"],
        "properties": {
          "code": { "type": "string", "pattern": "^\\d{5}$" },
          "name": { "$ref": "#/$defs/localizedName" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "congreso": { "type": "string", "pattern": "^\\d{2}$" },
          "senado": { "type": "string", "pattern": "^\\d{2}(-[a-z-]+)?$" }
        }
      }
    }
  },
  "$defs": {
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["es", "ca"],
      "properties": {
        "es": { "type": "string", "minLength": 1 },
        "ca": { "type": "string", "minLength": 1 }
      }
    },
    "constituency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "seats", "maxMarks"],
      "properties": {
        "id": { "type": "string", "pattern": "^\\d{2}(-[a-z-]+)?$" },
        "name": { "$ref": "#/$defs/localizedName" },
        "seats": { "type": "integer", "minimum": 1 },
        "maxMarks": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
